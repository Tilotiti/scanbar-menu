    "To save barcode images, choose a save folder in Configuration. Click the menu bar icon, then Configuration." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Um Barcode-Bilder zu speichern, wählen Sie einen Ordner in den Einstellungen. Klicken Sie auf das Symbol in der Menüleiste, dann auf Einstellungen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Para guardar imágenes de códigos de barras, elija una carpeta en Configuración. Haga clic en el icono de la barra de menús y luego en Configuración." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pour enregistrer les images de codes-barres, choisissez un dossier dans Configuration. Cliquez sur l'icône de la barre de menu, puis sur Configuration." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Per salvare le immagini dei codici a barre, scegli una cartella in Configurazione. Clicca sull'icona della barra dei menu, poi su Configurazione." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "バーコード画像を保存するには、設定でフォルダを選択してください。メニューバーのアイコンをクリックし、設定を選びます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要保存条形码图像，请在设置中选择保存文件夹。点击菜单栏图标，然后点击设置。" } }
